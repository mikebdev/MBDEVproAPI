  },

  "DefaultProjectSettings": {
    "ProjectName": "MBDEVproAPI",
    "Description": "MBDEVproAPI version .NET CORE 10",
    "SomeKey": "xcxc",
    "SessionTimeout": "900000",
    "ApplicationURL": "https://www.google.com",
